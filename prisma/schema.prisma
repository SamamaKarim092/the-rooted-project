datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Goal {
  id                 String      @id @default(cuid())
  userId             String      @default("default_user")
  title              String
  description        String?
  category           String      @default("Craft") // Mind, Body, Craft, Spirit, Career, Study
  targetDate         DateTime?
  progressPercentage Int         @default(0)
  status             String      @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  milestones         Milestone[]
  habits             Habit[]
  tasks              Task[]

  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  stage       String    @default("Milestone") // Seed, Sprout, Milestone
  isCompleted Boolean   @default(false)
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  tasks       Task[]
}

model Habit {
  id                String     @id @default(cuid())
  userId            String     @default("default_user")
  title             String
  description       String?
  category          String     @default("Mind") // Mind, Body, Craft, Spirit
  frequencyType     String     @default("DAILY") // DAILY, TIMES_PER_WEEK
  targetDaysPerWeek Int        @default(7)
  targetValue       Int        @default(1)
  unit              String     @default("times") // times, mins, pages
  color             String     @default("#7C9A86")
  status            String     @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  completedAt       DateTime?
  completionNote    String?
  goalId            String?
  goal              Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt
  logs              HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  completed Boolean  @default(true)
  value     Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

model Task {
  id          String     @id @default(cuid())
  userId      String     @default("default_user")
  title       String
  description String?
  priority    String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  dueDate     String?    // "YYYY-MM-DD"
  dueTime     String?    // "6:00 PM"
  category    String     @default("Craft") // Mind, Body, Craft, Spirit, Work, Study, Career
  goalId      String?
  goal        Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  order       Int        @default(0)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model SleepLog {
  id              String   @id @default(cuid())
  userId          String   @default("default_user")
  date            String   // "YYYY-MM-DD" representing morning / wake-up day
  bedtime         String   // e.g. "23:00" or "11:00 PM"
  wakeTime        String   // e.g. "07:30" or "07:30 AM"
  durationMinutes Int      // Total minutes slept (e.g. 510 = 8h 30m)
  quality         String?  // "RESTFUL", "BALANCED", "LIGHT", "RESTLESS"
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model SleepSetting {
  id          String   @id @default(cuid())
  userId      String   @unique @default("default_user")
  targetHours Float    @default(8.0) // Target sleep duration in hours (e.g. 8.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String   @default("default_user")
  title     String   @default("Untitled Note")
  content   String   @default("")
  category  String   @default("General") // Mind, Body, Craft, Spirit, Study, Career, General
  isPinned  Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String    @default("AI Connector")
  keyHash    String    @unique
  keyPrefix  String    // e.g. "rooted_pat_abc123..."
  userId     String    // Clerk User ID ownership
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

